# Backend. Copy to server/.env and fill in. Never commit the real .env.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=<at-least-32-random-characters>

# Which web pages may call this API from a browser. Comma separated origins, no trailing slash. Required in
# production: the server does not start without it, and every entry must be an https origin (never *).
# Localhost origins are allowed automatically while NODE_ENV is not "production".
# Exact https origins only, no wildcards. A Vercel preview deployment has its own address: add that exact origin if you need to test one.
#   https://<project>.vercel.app
CORS_ORIGINS=

# Set to production on the hosting service.
NODE_ENV=development

# How many proxies sit in front of the server (for example 1 on most hosts). Needed so the login rate limit
# counts real visitor IPs. Leave empty when the server is reached directly.
TRUST_PROXY=

# Where uploaded files are kept: gridfs (the database, survives a host restart; the default in production) or disk (a local folder; the default otherwise)
FILE_STORE=gridfs

# Brevo SMTP email notifications. Use the SMTP login and SMTP key from Brevo's
# SMTP & API settings (the SMTP key, not a regular account password or API key).
# SMTP_FROM must be a sender address verified in your Brevo account.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<brevo-smtp-login>
SMTP_PASS=<brevo-smtp-key>
SMTP_FROM=<verified-sender-address>

# The address of the website (for example https://your-site.vercel.app). Notification emails get an "Open CZAMS" button, and password reset emails
# link to <APP_URL>/reset-password. Needed in production for forgot password to send a usable link.
APP_URL=
