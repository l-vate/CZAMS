# Backend. Copy to server/.env and fill in. Never commit the real .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000

# Which web pages may call this API from a browser. Comma separated origins, no trailing slash. Required in
# production: if it is missing there, no other site can call the API (and one warning is logged).
# Localhost origins are allowed automatically while NODE_ENV is not "production".
# A * inside the host stands for letters, digits and hyphens only, so one entry can cover Vercel previews:
#   https://<project>.vercel.app,https://<project>-*-<team>.vercel.app
# Replace <project> and <team> with the real names from the Vercel dashboard; do not guess them.
CORS_ORIGINS=

# Set to production on the hosting service.
NODE_ENV=development

# How many proxies sit in front of the server (for example 1 on most hosts). Needed so the login rate limit
# counts real visitor IPs. Leave empty when the server is reached directly.
TRUST_PROXY=

# Where uploaded files are kept: gridfs (the database, survives a host restart; the default in production) or disk (a local folder; the default otherwise)
FILE_STORE=gridfs

# Brevo email notifications. On Render, use the HTTPS API (port 443): create an
# API key in Brevo's SMTP & API settings and set SMTP_FROM to a verified sender.
# BREVO_API_KEY takes precedence over SMTP settings when both are configured.
BREVO_API_KEY=your-brevo-api-key

# Brevo SMTP email notifications. Use the SMTP login and SMTP key from Brevo's
# SMTP & API settings (the SMTP key, not a regular account password or API key).
# SMTP_FROM must be a sender address verified in your Brevo account.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=CZAMS <verified-sender@example.com>
